# Mẫu biến môi trường gốc cho Docker Compose & Kubernetes (`./k8s/create-secrets.sh`).
# Sao chép file này thành `.env` rồi điền giá trị thật (không commit `.env`).

# ---- MySQL ----
DB_PORT=3306
DB_NAME=backend_instagram
DB_USERNAME=instagram_user
DB_PASSWORD=instagram_pass
DB_ROOT_PASSWORD=rootpassword
DDL_AUTO=update
SHOW_SQL=false

# ---- JWT (bắt buộc: tạo bằng `openssl rand -base64 64 | tr -d '\n'`) ----
JWT_BASE64_SECRET=replace_with_a_random_base64_secret
JWT_TOKEN_VALIDITY_SECONDS=1800
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=604800

# ---- Backend & Security ----
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# ---- Frontend ----
REACT_APP_API_URL=http://localhost:8081

# ---- Redis Cache ----
SPRING_CACHE_TYPE=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_POSTS=60
CACHE_TTL_COMMENTS=60
CACHE_TTL_USER_STATS=120

# ---- RabbitMQ ----
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=instagram
RABBITMQ_PASSWORD=instagram_pass
RABBITMQ_VHOST=/instagram
MQ_ENABLED=true
MQ_NOTIFICATION_CONCURRENCY=2
MQ_NOTIFICATION_MAX_ATTEMPTS=4
MQ_NOTIFICATION_RETRY_INITIAL_MS=1000
MQ_NOTIFICATION_RETRY_MULTIPLIER=2

# ---- AWS S3 / LocalStack ----
ACCESS_KEY=test
SECRET_KEY=test
REGION=ap-southeast-1
BUCKET_NAME=instagram-media
S3_ENDPOINT=http://localstack:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566

# ---- Gemini AI ----
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# ---- Resource Limits (Docker Compose) ----
MYSQL_MEM_LIMIT=1g
BACKEND_MEM_LIMIT=1g
