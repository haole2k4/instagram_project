# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=backend_instagram
DB_USERNAME=root
DB_PASSWORD=

# JWT Configuration
JWT_BASE64_SECRET=replace_with_a_random_base64_secret
JWT_TOKEN_VALIDITY_SECONDS=1800
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=604800

# Gemini API (IMPORTANT: Replace with your own key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# AWS S3 / LocalStack Configuration
ACCESS_KEY=test
SECRET_KEY=test
REGION=ap-southeast-1
BUCKET_NAME=instagram-media
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566

# RabbitMQ (message queue cho notification)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=instagram
RABBITMQ_PASSWORD=instagram_pass
RABBITMQ_VHOST=/instagram
MQ_ENABLED=true
MQ_NOTIFICATION_CONCURRENCY=2
MQ_NOTIFICATION_MAX_ATTEMPTS=4
MQ_NOTIFICATION_RETRY_INITIAL_MS=1000
MQ_NOTIFICATION_RETRY_MULTIPLIER=2

# Server Configuration
SERVER_PORT=8081

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_POSTS=60
CACHE_TTL_COMMENTS=60
CACHE_TTL_USER_STATS=120

# Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000
